		<category id="terrain_modification_usage" name="Terrain Modification &amp; Usage" order="90" img="data/cpp_samples/terrain_modification_usage/terrain_modification_usage.png"/>
		<category id="physics" name="Physics" order="100" img="data/cpp_samples/physics/physics.png"/>
