		<category id="multi_threading_performance_optimization" name="Multithreading &amp; Performance Optimization" order="60" img="data/cpp_samples/multi_threading_performance_optimization/multi_threading_performance_optimization.png"/>
		<category id="simulation" name="Simulation" order="70" img="data/cpp_samples/simulation/simulation.png"/>
