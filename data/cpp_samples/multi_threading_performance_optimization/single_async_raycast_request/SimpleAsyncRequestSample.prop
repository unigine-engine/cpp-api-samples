<property version="2.21.0.0" name="SimpleAsyncRequestSample" manual="1" parent_name="node_base" tooltip="This component performs an asynchronous intersection from the player toward the mouse cursor, visualizes the hit with a normal vector, and displays average and maximum time latency in the UI.">
