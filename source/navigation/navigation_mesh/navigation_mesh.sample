<?xml version="1.0" encoding="utf-8"?>
<sample title="Navigation Mesh">
	<sdk_desc>Configuring pathfinding between two points with obstacles using <i>Navigation Mesh</i>.</sdk_desc>
	<desc>
		<brief>This sample demonstrates how to configure pathfinding between two points with obstacles using <ui>Navigation Mesh</ui>. The <ui>Route radius</ui> parameter controls the navigation width - increasing it creates wider paths that maintain safe distance from obstacles, while decreasing it allows navigation through tighter spaces.</brief>
	</desc>
	<controls>
		<![CDATA[
		<p>Move the path endpoints and obstacles in the scene with the <b>widget manipulator</b>.<br/>
		<b>LMB</b> click on object to show the manipulator.</p>
		]]>
	</controls>
	<tags>
		<tag>Navigation &amp; Patfinding</tag>
	</tags>
</sample>