<?xml version="1.0" encoding="utf-8"?>
<sample title="Physics Movement">
	<sdk_desc>Simple logic of moving an object using physical methods (by force or by impulse).</sdk_desc>
	<desc>
		<brief>
			<para>This sample demonstrates a simple logic of moving an object using physical methods (by force or by impulse).</para>
			<para>You can choose the desired method and control maximum speed, rotation speed, and accelerations using sliders.</para>
		</brief>
	</desc>
	<controls>
		<![CDATA[
		<p align=left><b>W/S</b> - Move forward/backward.<br/>
		<b>A/D</b> - Turn left/right.<br/>
		<b>SPACE</b> - Jump.</p>
		]]>
	</controls>
	<tags>
		<tag>Physics</tag>
	</tags>
</sample>