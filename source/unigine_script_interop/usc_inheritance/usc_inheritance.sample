<?xml version="1.0" encoding="utf-8"?>
<sample title="Usc Inheritance">
	<sdk_desc>Working with <i>UnigineScript</i> containers via <i>C++ API</i>.</sdk_desc>
	<desc>
		<brief>
			<para>This sample demonstrates how to work with <ui>UnigineScript</ui> containers via <ui>C++ API</ui>. It showcases class composition, constructor registration, base-to-derived linkage, and virtual method exposure within a scripting context.</para>
			<para>Each class in the hierarchy is registered via the <ui><link to="interpreter_class">Interpreter</link></ui> class, allowing scripts to instantiate and interact with derived types, call inherited methods, and override behavior.</para>
		</brief>
	</desc>
	<tags>
		<tag>UnigineScript</tag>
	</tags>
</sample>
